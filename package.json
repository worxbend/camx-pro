{
  "name": "camx-pro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/site",
    "apps/remote",
    "packages/control",
    "packages/bridge"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:site": "npm run dev --workspace @camx-pro/site",
    "dev:remote": "npm run dev --workspace @camx-pro/remote",
    "build": "npm run build --workspace @camx-pro/remote && npm run build --workspace @camx-pro/site && node tools/website/build.mjs",
    "build:remote": "npm run build --workspace @camx-pro/remote",
    "bridge": "node packages/bridge/src/server.mjs",
    "test": "node --test packages/*/test/*.test.mjs",
    "test:browser": "playwright test",
    "test:model": "node apps/site/scripts/verify-model.mjs",
    "test:firmware-ui": "node firmware/tools/test_ui.mjs",
    "format": "prettier --ignore-path .gitignore --write \"apps/**/*.{js,jsx,mjs,json,html,css}\" \"packages/**/*.{mjs,json}\" \"tests/integration/**/*.{js,mjs}\" \"tools/website/*.mjs\" package.json playwright.config.js .prettierrc.json",
    "format:check": "prettier --ignore-path .gitignore --check \"apps/**/*.{js,jsx,mjs,json,html,css}\" \"packages/**/*.{mjs,json}\" \"tests/integration/**/*.{js,mjs}\" \"tools/website/*.mjs\" package.json playwright.config.js .prettierrc.json",
    "test:assets": "python3 -m unittest discover -s tools/website/tests",
    "assets:fetch": "python3 tools/website/assets.py fetch"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "prettier": "3.9.10"
  }
}
